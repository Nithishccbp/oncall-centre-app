{
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/telephony?op=config"
    },
    {
      "source": "/api/telephony/answer/:ref",
      "destination": "/api/telephony?op=answer&ref=:ref"
    },
    {
      "source": "/api/telephony/hook/:ref/:ev",
      "destination": "/api/telephony?op=hook&ref=:ref&ev=:ev"
    },
    {
      "source": "/api/telephony/:op",
      "destination": "/api/telephony?op=:op"
    },
    {
      "source": "/api/ingest/conversation",
      "destination": "/api/ingest"
    },
    {
      "source": "/api/ingest/batch",
      "destination": "/api/ingest"
    },
    {
      "source": "/api/conversations",
      "destination": "/api/ingest"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}