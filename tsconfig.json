{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "skipLibCheck": true, "moduleResolution": "bundler", "resolveJsonModule": true,
    "isolatedModules": true, "noEmit": true, "jsx": "react-jsx", "allowJs": false,
    "strict": true, "noFallthroughCasesInSwitch": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "api", "vite.config.ts"]
}
