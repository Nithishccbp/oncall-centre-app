# Optional. Only needed if you self-host a PeerJS server (the free public one is used by default).
# VITE_PEER_HOST=localhost
# VITE_PEER_PORT=9000
# VITE_PEER_SECURE=false

# Set these in Vercel -> Project -> Settings -> Environment Variables (NOT in code):
# GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-flash-latest

# Real phone calls (Twilio) — set in Vercel, never in code. See TWILIO_SETUP.md
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_API_KEY=SK...
# TWILIO_API_SECRET=...
# TWILIO_TWIML_APP_SID=AP...
# TWILIO_NUMBER=+1...        # your Twilio number (caller ID)
# APP_PASSCODE=              # optional: asked once in the browser before any phone call
# KV_REST_API_URL / KV_REST_API_TOKEN   # optional: Upstash Redis (live AI-call transcript)

# --- Vonage (alternative to Twilio for AI -> phone calls; Vonage wins if both are set) ---
# VONAGE_APPLICATION_ID=        # the Application id (a UUID) from the Vonage dashboard
# VONAGE_PRIVATE_KEY=           # the WHOLE text of the private.key file (or the same text base64-encoded)
# VONAGE_FROM=                  # optional, digits only; leave empty on a trial account (uses Vonage's test caller id)
# VONAGE_VOICE_STYLE=0          # optional voice style number for English (India)
